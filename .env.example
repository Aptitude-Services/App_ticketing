# --- Domaine et certificats ---
SITE_DOMAIN=support.aptitudes.net
ACME_EMAIL=infra@aptitudes.net
# Plages autorisées pour /gestion, séparées par des virgules (à restreindre aux IP Aptitude)
ADMIN_ALLOWED_IPS=0.0.0.0/0

# --- Django ---
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=support.aptitudes.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://support.aptitudes.net
AXES_PROXY_COUNT=1

# --- Base de données ---
POSTGRES_DB=aptitude_support
POSTGRES_USER=aptitude
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-fort

# --- Emails (Microsoft 365) ---
DEFAULT_FROM_EMAIL=Aptitude Support <support@aptitudes.net>

# Option A (recommandée) : API Microsoft Graph, voir l'inscription d'application dans Entra ID
EMAIL_BACKEND=core.graph_mail.GraphEmailBackend
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAIL_SENDER=support@aptitudes.net

# Option B (temporaire, jusqu'à fin 2026) : SMTP AUTH. Remplacer EMAIL_BACKEND ci-dessus par :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=support@aptitudes.net
EMAIL_HOST_PASSWORD=
